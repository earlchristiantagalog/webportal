{
  "name": "webportal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config backend/prisma.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config backend/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config backend/prisma.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "typescript": "^5"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
